# APPLICATION ENVIRONMENT
APP_NAME=
APP_ENV=
APP_KEY=
APP_DEBUG=
APP_URL=

# Default application timezone (Philippine Standard Time)
APP_TIMEZONE=Asia/Manila

# LOGGING ENVIRONMENT
LOG_CHANNEL=
LOG_DEPRECATIONS_CHANNEL=
LOG_LEVEL=

# DATABASE ENVIRONMENT
DB_CONNECTION=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# BROADCAST ENVIRONMENT
BROADCAST_DRIVER=
CACHE_DRIVER=
FILESYSTEM_DISK=
QUEUE_CONNECTION=

# SESSION ENVIRONMENT
SESSION_DRIVER=
SESSION_LIFETIME=

# MEMCACHED ENVIRONMENT
MEMCACHED_HOST=

# REDIS ENVIRONMENT
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=

# MAIL ENVIRONMENT
MAIL_MAILER=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# PUSHER ENVIRONMENT (INERTIA.JS)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=
PUSHER_SCHEME=
PUSHER_APP_CLUSTER=

# PUSHER ENVIRONMENT (INERTIA.JS)
VITE_PUSHER_APP_KEY=
VITE_PUSHER_HOST=
VITE_PUSHER_PORT=
VITE_PUSHER_SCHEME=
VITE_PUSHER_APP_CLUSTER=

# XENDIT — test mode (Developers → API Keys → Secret key xnd_development_…)
# Webhook URL: {APP_URL}/api/webhooks/xendit  (use ngrok locally if needed)
# Webhook token must match the verification token in the Xendit dashboard.
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_API_BASE_URL=https://api.xendit.co

# Google Gemini — system API key for creator quiz generation and student AI grading
GEMINI_API_KEY=
# Optional rotation pool (tried in order when primary key is rate-limited)
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# Optional preferred model (defaults to gemini-2.5-flash-lite when unset)
# GEMINI_MODEL=gemini-2.5-flash-lite
# Max seconds to wait per Gemini HTTP request (fail fast; default 45)
# GEMINI_TIMEOUT=45